<?xml version="1.0"?>
<robot name="letter_s">

  <link name="s_link">

    <!-- Inertial -->
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <mass value="1.0"/>
      <inertia
        ixx="9.17e-4"
        iyy="3.63e-4"
        izz="1.18e-3"
        ixy="0.0"
        ixz="0.0"
        iyz="0.0"/>
    </inertial>

    <!-- Visual -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="alphabets/S/s_centered.ply"
              scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="letter_material">
        <color rgba="1 0.647 0 1"/>
      </material>
    </visual>

    <!-- Collision -->
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="alphabets/S/s_centered.ply"
              scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>

  </link>
</robot>